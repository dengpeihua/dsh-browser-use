          "script": "function extractColors() {\n  const results = {};\n  \n  // Look for color buttons/links\n  const colorButtons = document.querySelectorAll('[aria-label*=\"iMac\"], [aria-label*=\"color\"], [aria-label*=\"Color\"], [aria-label*=\"Green\"], [aria-label*=\"Yellow\"], [aria-label*=\"Orange\"], [aria-label*=\"Pink\"], [aria-label*=\"Purple\"], [aria-label*=\"Blue\"], [aria-label*=\"Silver\"]');\n  results.colorButtons = Array.from(colorButtons).map(el => ({\n    tag: el.tagName,\n    ariaLabel: el.getAttribute('aria-label'),\n    text: el.textContent.trim().substring(0, 100),\n    className: el.className\n  }));\n  \n  // Look for color swatch images\n  const allImages = document.querySelectorAll('img, picture');\n  results.colorImages = [];\n  allImages.forEach(el => {\n    const alt = el.getAttribute('alt') || '';\n    if (alt && (alt.toLowerCase().includes('imac') || alt.toLowerCase().match(/\\b(green|yellow|orange|pink|purple|blue|silver)\\b/))) {\n      results.colorImages.push({tag: el.tagName, alt: alt});\n    }\n  });\n  \n  // Look for color swatches\n  const swatches = document.querySelectorAll('[class*=\"swatch\"], [class*=\"color-\"], [data-color], [data-color-name]');\n  results.swatches = Array.from(swatches).map(el => ({\n    tag: el.tagName,\n    className: el.className,\n    ariaLabel: el.getAttribute('aria-label'),\n    dataColor: el.getAttribute('data-color'),\n    dataColorName: el.getAttribute('data-color-name')\n  }));\n  \n  return results;\n}\nreturn extractColors();"
