        "script": "function thoroughSearch() {\n  // Get all section labels/titles\n  const allSectionTitles = [];\n  const elements = document.querySelectorAll('[data-testid=\"section-title-wrapper\"] *');\n  elements.forEach(el => {\n    const text = el.textContent.trim();\n    if (text && !allSectionTitles.includes(text)) {\n      allSectionTitles.push(text);\n    }\n  });\n  \n  // Also check for any links or buttons that mention new releases\n  const linksAndButtons = document.querySelectorAll('a, button');\n  const newReleaseRefs = [];\n  linksAndButtons.forEach(el => {\n    if (el.textContent.toLowerCase().includes('new release') || \n        (el.getAttribute('aria-label') || '').toLowerCase().includes('new release') ||\n        (el.getAttribute('href') || '').toLowerCase().includes('new-release')) {\n      newReleaseRefs.push({\n        tag: el.tagName,\n        text: el.textContent.trim().substring(0, 100),\n        href: el.getAttribute('href') || '',\n        ariaLabel: el.getAttribute('aria-label') || ''\n      });\n    }\n  });\n  \n  // Check all data-testid attributes\n  const allDataTestids = [];\n  document.querySelectorAll('[data-testid]').forEach(el => {\n    const tid = el.getAttribute('data-testid') || '';\n    if (tid.includes('release') || tid.includes('new')) {\n      allDataTestids.push(tid + ': ' + el.textContent.trim().substring(0, 50));\n    }\n  });\n  \n  return {\n    sectionTitles: allSectionTitles,\n    newReleaseRefs: newReleaseRefs,\n    newTestids: allDataTestids\n  };\n}\nreturn JSON.stringify(thoroughSearch(), null, 2);"
