{
  "name": "dsh-browser-plugin",
  "version": "0.1.0",
  "description": "Native DeepSeek Harness browser-agent plugin with Session-isolated Chromium, CDP, and DOM tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./diagnostics": {
      "types": "./lib/diagnostics.d.ts",
      "default": "./lib/diagnostics.js"
    }
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "docs",
    "assets/benchmark",
    "cordis.patch.yml",
    "AGENTS.md",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "marketplace": {
      "profiles": [
        "web"
      ],
      "requiresBuildApproval": false,
      "requiresRestart": true,
      "manualSteps": false
    }
  },
  "scripts": {
    "eval": "node scripts/eval/run.mjs",
    "eval:prepare": "node scripts/eval/prepare.mjs",
    "eval:test": "node --test test/eval.test.mjs test/eval-reliability.test.mjs test/eval-metrics.test.mjs test/eval-reference-judge.test.mjs",
    "eval:smoke": "npm run build && node scripts/eval/smoke.mjs",
    "build": "tsdown",
    "clean": "tsdown --clean",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:smoke": "npm run build && node scripts/smoke-browser.mjs && node scripts/smoke-reliability.mjs && node scripts/smoke-migration.mjs && node scripts/smoke-command-errors.mjs",
    "dom:regression": "node scripts/dom-regression.mjs",
    "verify:package": "node --test test/package.test.mjs",
    "verify:installed": "node scripts/verify-installed-package.mjs",
    "check": "npm test && npm run verify:installed",
    "test:host": "npm run build && node scripts/smoke-host.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dengpeihua/dsh-browser-use.git"
  },
  "homepage": "https://github.com/dengpeihua/dsh-browser-use#readme",
  "bugs": {
    "url": "https://github.com/dengpeihua/dsh-browser-use/issues"
  },
  "dependencies": {
    "puppeteer-core": "25.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-token-meter": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm-retry": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "24.10.1",
    "semver": "7.8.5",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "yaml": "^2.9.1"
  }
}
